<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="model" default="ace"/>
  <xacro:arg name="model_name" default=""/>
  <xacro:arg name="width" default="1936"/>
  <xacro:arg name="height" default="1216"/>
  <xacro:arg name="fov" default="69.322305"/>
  <xacro:arg name="near" default="0.02"/>
  <xacro:arg name="far" default="300.0"/>

  <xacro:macro name="basler" params="model:=ace model_name:='' width:=1936 height:=1216 fov:=69.322305 near:=0.02 far:=300.0">
    <xacro:property name="resolved_name" value="${model_name if model_name else ('basler_' + model)}"/>
    <model name="${resolved_name}">
      <static>true</static>
      <include merge="true">
        <uri>model://intrinsic_perception/intrinsic/perception/cameras/hardware_devices/basler_${model}_body.sdf</uri>
      </include>
      <link name="sensor_link">
        <!-- TODO(b/293895161) Set a tiny mass and inertia for link without any physical extent. -->
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>0.000001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000001</iyy>
            <iyz>0</iyz>
            <izz>0.000001</izz>
          </inertia>
        </inertial>
        <sensor name="basler" type="camera">
          <!-- Rotate sensor so that camera frame conforms to the Intrinsic convention
               (z forward, x right, y down). -->
          <pose degrees="true">0 0 0 90 -90 0</pose>
          <update_rate>10.0</update_rate>
          <camera name="head">
            <!-- 2 * atan2(width, 2 * fx) -->
            <horizontal_fov>${fov*pi/180}</horizontal_fov>
            <image>
              <width>${width}</width>
              <height>${height}</height>
              <format>R8G8B8</format>
            </image>
            <lens>
              <intrinsics>
                <fx>${width/2/tan(fov*pi/360)}</fx>
                <fy>${width/2/tan(fov*pi/360)}</fy>
                <cx>${width/2-0.5}</cx>
                <cy>${height/2-0.5}</cy>
              </intrinsics>
            </lens>
            <clip>
              <near>${near}</near>
              <far>${far}</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
          </camera>
          <plugin filename="static://intrinsic::simulation::CameraPlugin"
            name="intrinsic::simulation::CameraPlugin">
          </plugin>
        </sensor>
        <collision name="collision">
          <pose>0.003 -0.004 -0.127 0 0 0</pose>
          <geometry>
            <box>
              <size>0.02 0.02 0.0445</size>
            </box>
          </geometry>
        </collision>
      </link>
      <joint name="camera_joint" type="fixed">
        <parent>body</parent>
        <child>sensor_link</child>
      </joint>
    </model>
  </xacro:macro>

  <xacro:basler model="$(arg model)" model_name="$(arg model_name)" width="$(arg width)" height="$(arg height)" fov="$(arg fov)" near="$(arg near)" far="$(arg far)"/>
</sdf>
