metadata {
  id {
    package: "ai.intrinsic"
    name: "calibration_service"
  }
  vendor {
    display_name: "Intrinsic"
  }
  documentation {
    description: "A camera calibration service."
  }
  display_name: "Calibration Service"
}
service_def {
  config_message_full_name: "intrinsic_proto.perception.v1.CalibrationServiceConfig"
  service_proto_prefixes: "/intrinsic_proto.perception.v1.CalibrationService/"
  real_spec {
    image {
      archive_filename: "calibration-service-image.tar"
    }
  }
  sim_spec {
    image {
      archive_filename: "calibration-service-image.tar"
    }
  }
}
