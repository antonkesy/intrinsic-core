name: "ai.intrinsic.ioc_pose_estimation.segmentor.rfdetr"
backend: "onnxruntime"
default_model_filename: "segmentation.onnx"

input [
  {
    name: "input"
    data_type: TYPE_UINT8
    dims: [1, 3, -1, -1]
  },
  {
    name: "thresholds"
    data_type: TYPE_FP32
    dims: [1, 2]
  }
]

output [
  {
    name: "boxes"
    data_type: TYPE_FP32
    dims: [-1, 4]
  },
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [-1]
  },
  {
    name: "masks"
    data_type: TYPE_BOOL
    dims: [-1, -1, -1]
  },
  {
    name: "visibility"
    data_type: TYPE_FP32
    dims: [-1]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
