metadata {
  id {
    package: "ai.intrinsic"
    name: "ioc_pose_estimator_service"
  }
  vendor {
    display_name: "Intrinsic"
  }
  documentation {
    description: "Image-based Object Center Pose Estimator Service Prototype"
  }
  display_name: "IOC Pose Estimator Service"
}

service_def {
  service_proto_prefixes: "/intrinsic_proto.perception.v1.PoseEstimationService/"
  config_message_full_name: "intrinsic_proto.perception.ioc.IocPoseEstimatorServiceConfig"
  real_spec {
    image {
      archive_filename: "ioc_pose_estimator_image.tar"
    }
  }

  sim_spec {
    image {
      archive_filename: "ioc_pose_estimator_image.tar"
    }
  }
}
