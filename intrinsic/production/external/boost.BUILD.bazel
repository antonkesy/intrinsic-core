load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

exports_files(["LICENSE_1_0.txt"])

license(
    name = "license",
    package_name = "boost",
    license_kinds = [
        "@rules_license//licenses/spdx:BSL-1.0",
    ],
    license_text = "LICENSE_1_0.txt",
    package_url = "https://github.com/boostorg/boost",
)

cc_library(
    name = "boost",
    srcs = glob([
        "libs/*/include/**/*.hpp",
        "libs/*/include/**/*.h",
        "libs/*/include/**/*.ipp",
        "libs/*/*/include/**/*.hpp",
        "libs/*/*/include/**/*.h",
        "libs/*/*/include/**/*.ipp",
    ]),
    includes = glob(
        [
            "libs/*/include",
            "libs/*/*/include",
        ],
        exclude_directories = 0,
    ),
)