"""
GLVND GL/EGL and host glib system library stubs from the sysroot.
- GLVND stubs are needed to route OpenGL calls to host drivers.
- Glib/GObject/GIO/GModule stubs are needed to link against host
  glib libraries when a target needs access to Qt6.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "files",
    srcs = glob([
        # OpenGL and EGL deps
        "usr/lib/x86_64-linux-gnu/libGL.so*",
        "usr/lib/x86_64-linux-gnu/libGLX.so*",
        "usr/lib/x86_64-linux-gnu/libEGL.so*",
        "usr/lib/x86_64-linux-gnu/libGLdispatch.so*",
        "usr/lib/x86_64-linux-gnu/libOpenGL.so.*",
        "usr/lib/x86_64-linux-gnu/libX11.so*",
        "usr/lib/x86_64-linux-gnu/libxcb.so*",
        "usr/lib/x86_64-linux-gnu/libXau.so*",
        "usr/lib/x86_64-linux-gnu/libXdmcp.so*",
        "usr/lib/x86_64-linux-gnu/libXext.so*",
        "usr/lib/x86_64-linux-gnu/libbsd.so*",
        "usr/lib/x86_64-linux-gnu/libmd.so*",
    ]),
)

cc_library(
    name = "sysroot_glvnd_stubs",
    srcs = [":files"],
)

# We need to compile a dummy empty.cc file into all system glib stubs.
# Bazel's cc_shared_library rule has a strict analysis-phase check that fails
# if a target in its transitive deps contains only precompiled dynamic libraries
# (.so files) with no compiled objects. The dummy empty.cc forces Bazel to compile
# an object file and package it, satisfying the cc_shared_library check.
genrule(
    name = "empty_cc",
    outs = ["empty.cc"],
    cmd = "touch $@",
)

cc_library(
    name = "system_glib",
    srcs = glob([
        "usr/lib/x86_64-linux-gnu/libglib-2.0.so*",
        "lib/x86_64-linux-gnu/libpcre.so.3*",
    ]) + [":empty_cc"],
    hdrs = glob([
        "usr/include/glib-2.0/**/*.h",
        "usr/lib/x86_64-linux-gnu/glib-2.0/include/**/*.h",
    ]),
    includes = [
        "usr/include/glib-2.0",
        "usr/lib/x86_64-linux-gnu/glib-2.0/include",
    ],
)

cc_library(
    name = "system_gobject",
    srcs = glob([
        "usr/lib/x86_64-linux-gnu/libgobject-2.0.so*",
        "usr/lib/x86_64-linux-gnu/libffi.so.7*",
    ]) + [":empty_cc"],
    hdrs = glob([
        "usr/include/glib-2.0/**/*.h",
        "usr/lib/x86_64-linux-gnu/glib-2.0/include/**/*.h",
    ]),
    includes = [
        "usr/include/glib-2.0",
        "usr/lib/x86_64-linux-gnu/glib-2.0/include",
    ],
    deps = [":system_glib"],
)

cc_library(
    name = "system_gio",
    srcs = glob([
        "usr/lib/x86_64-linux-gnu/libgio-2.0.so*",
        "usr/lib/x86_64-linux-gnu/libmount.so.1*",
        "usr/lib/x86_64-linux-gnu/libblkid.so.1*",
        "lib/x86_64-linux-gnu/libselinux.so.1*",
    ]) + [":empty_cc"],
    hdrs = glob([
        "usr/include/glib-2.0/**/*.h",
        "usr/lib/x86_64-linux-gnu/glib-2.0/include/**/*.h",
        "usr/include/gio-unix-2.0/**/*.h",
    ]),
    includes = [
        "usr/include/gio-unix-2.0",
        "usr/include/glib-2.0",
        "usr/lib/x86_64-linux-gnu/glib-2.0/include",
    ],
    deps = [
        ":system_glib",
        ":system_gobject",
    ],
)

cc_library(
    name = "system_gmodule",
    srcs = glob(["usr/lib/x86_64-linux-gnu/libgmodule-2.0.so*"]) + [":empty_cc"],
    hdrs = glob([
        "usr/include/glib-2.0/**/*.h",
        "usr/lib/x86_64-linux-gnu/glib-2.0/include/**/*.h",
    ]),
    includes = [
        "usr/include/glib-2.0",
        "usr/lib/x86_64-linux-gnu/glib-2.0/include",
    ],
    deps = [":system_glib"],
)
