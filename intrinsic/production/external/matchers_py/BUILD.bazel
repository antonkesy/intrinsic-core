# oss replacement for //testing/pymocks:matchers
load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

# To copy the http_file from external repo locally. Giving http_file to srcs to py_library doesn't work.
copy_file(
    name = "matchers_py_file",
    src = "@com_googlecloudplatform_perfkitbenchmarker_tests_matchers_py//file",
    out = "matchers.py",
    allow_symlink = True,
)

py_library(
    name = "matchers",
    srcs = [":matchers_py_file"],
    imports = ["google3"],  # TODO b/477580650: Remove this.
    deps = [
        "@com_google_absl_py//absl/logging",
    ],
)
