load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

exports_files(["COPYING"])

license(
    name = "license",
    package_name = "gperftools",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
    license_text = "COPYING",
    package_url = "https://github.com/gperftools/gperftools",
)

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

cmake(
    name = "gperftools",
    cache_entries = {
        "BUILD_TESTING": "OFF",
        "GPERFTOOLS_BUILD_CPU_PROFILER": "ON",
        "GPERFTOOLS_BUILD_DEBUGALLOC": "OFF",
        "GPERFTOOLS_BUILD_HEAP_CHECKER": "OFF",
        "GPERFTOOLS_BUILD_HEAP_PROFILER": "ON",
        "GPERFTOOLS_BUILD_MINIMAL": "OFF",
        "gperftools_enable_broken_install_targets": "ON",
        "gperftools_enable_frame_pointers": "ON",
        "gperftools_enable_libunwind": "OFF",
    },
    copts = ["-Wno-error"],
    env = {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_BUILD_PARALLEL_LEVEL": "4",
    },
    lib_source = ":all_srcs",
    out_shared_libs = [
        "libprofiler.so",
        "libtcmalloc.so",
    ],
)

cc_import(
    name = "libraries",
    hdrs = glob([
        "src/*.h",
        "src/base/*.h",
        "generic-config/*.h",
        "src/gperftools/*.h",
    ]),
    deps = [":gperftools"],
    linkopts = [
        "-lprofiler",
        "-ltcmalloc",
    ],
)
