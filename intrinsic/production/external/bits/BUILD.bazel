load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# buildifier: disable=external-path
copy_and_rename = "\n".join([
    "cp $< $@",
    # Replace S2 with INTRINSIC.
    "sed -i 's/S2_UTIL_/INTRINSIC_PRODUCTION_EXTERNAL_/g' $@",
    "sed -i 's/util_bits/intrinsic/g' $@",
    "sed -i 's/s2\\/util/intrinsic\\/production\\/external/g' $@",
    "sed -i 's/#include \"s2\\/base\\/types.h\"//g' $@",
    "sed -i 's/uint\\([0-9]*\\)/uint\\1_t/g' $@",
])

genrule(
    name = "bit_interleave_h",
    srcs = ["@com_google_s2geometry_bit_interleave_h//file"],
    outs = ["bit-interleave.h"],
    cmd = copy_and_rename,
    visibility = ["//visibility:public"],
)

genrule(
    name = "bit_interleave_cc",
    srcs = ["@com_google_s2geometry_bit_interleave_cc//file"],
    outs = ["bit-interleave.cc"],
    cmd = copy_and_rename,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bit_interleave",
    srcs = [":bit-interleave.cc"],
    hdrs = [":bit-interleave.h"],
)
