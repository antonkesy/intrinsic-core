id {
  package: "ai.intrinsic"
  name: "create_object"
}
display_name: "Create object"
vendor {
  display_name: "Intrinsic"
}
documentation {
  description:
    "Creates world object(s) from an installed Scene Object asset."
    "\n"
    "Allows the user to specify the poses to create the objects at."
    "\n"
    "Allows the user to specify a randomization parameter to randomize the poses."
    "\n"
    "Dependency note: This skill requires a ai.intrinsic.spawner service. "
}
options {
  supports_cancellation: false
  cc_config {
    create_skill: "::intrinsic::skills::CreateObject::CreateSkill"
  }
}
parameter {
  message_full_name: "ai.intrinsic.CreateObjectParams"
  default_value {
    type_url: "type.googleapis.com/ai.intrinsic.CreateObjectParams"
  }
}
return_type {
  message_full_name: "ai.intrinsic.CreateObjectResult"
}
