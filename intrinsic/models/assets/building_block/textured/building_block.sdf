<sdf version="1.6">
  <model name="Building_block">
    <link name="whole">
      <inertial>
        <!-- Center of mass. -->
        <pose>0 0 0 0 0 0</pose>
        <!-- Mass is in kg. The real piece probably doesn't weigh 50 g,
             but being a bit heavier makes the simulation much more stable. -->
        <mass>0.050</mass>
        <inertia>
          <ixx>0.0000014167</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000009502</iyy>
          <iyz>0</iyz>
          <izz>0.000010168</izz>
        </inertia>
      </inertial>
      <visual name="visual1">
        <geometry>
          <mesh>
            <!-- this is the original standard model from @colebsmr, 75x25x15mm. -->
            <!--uri>model://intrinsic/models/assets/building_block/textured/building_block.dae</uri-->
            <!-- this is a version of the standard model exported from meshlab (without rotation) so it should be compatible with the training pipeline. -->
            <uri>model://intrinsic/models/assets/building_block/textured/building_block.obj</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision1">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.075 0.025 0.015</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
