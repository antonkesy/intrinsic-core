<sdf version="1.6">
  <model name="Building_block">
    <link name="whole">
      <inertial>
        <!-- Center of mass. -->
        <pose>0.0 0.0 0.007 0 0 0</pose>
        <mass>0.020</mass>
        <inertia>
          <ixx>0.000002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000013</iyy>
          <iyz>0</iyz>
          <izz>0.000013</izz>
        </inertia>
      </inertial>
      <visual name="visual1">
        <geometry>
          <mesh>
            <uri>model://intrinsic/models/assets/building_block/long/building_block_long.dae</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision1">
        <pose>0 0 0.0075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.095 0.025 0.014</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
