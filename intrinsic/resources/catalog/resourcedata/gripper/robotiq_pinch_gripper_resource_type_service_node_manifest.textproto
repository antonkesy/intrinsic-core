metadata {
  id {
    package: "ai.intrinsic"
    name: "robotiq_gripper_service"
  }
  vendor {
    display_name: "Intrinsic"
  }
  documentation {
    description: "Robotiq Hand-E adaptive gripper."
  }
  display_name: "Robotiq Hand-E Adaptive Gripper"
  asset_tag: ASSET_TAG_GRIPPER

}
service_def {
  service_proto_prefixes: "/intrinsic_proto.gripper.GenericGripper/"
  service_proto_prefixes: "/intrinsic_proto.gripper.PinchGripperServer/"
  service_proto_prefixes: "/intrinsic_proto.services.v1.ServiceState/"
  service_state_config {
    service_versions: INTRINSIC_PROTO_SERVICES_V1_SERVICE_STATE
  }

  real_spec {
    image {
      archive_filename: "resource-pinch-gripper-server-image.tar"
    }
  }
  sim_spec {
    image {
      archive_filename: "resource-pinch-gripper-server-image.tar"
    }
  }
}
