[type.googleapis.com/intrinsic_proto.gripper.PinchGripperPart] {
  config: {
    generic_pinch_gripper_config: {
      comm_config: {
        ip_address: "192.168.1.91"
        port: 502
      }
      physical_config: {
        position: {
          si_properties: {
            range: {
              minimum: 0.0
              maximum: 0.05
            }
            increment: 0.001
            unit: "meters"
          }
          hardware_value_properties: {
            range: {
              minimum: 255
              maximum: 0
            }
            increment: 1
            unit: ""
          }
          default_si_value: 0.05
        }
        velocity: {
          si_properties: {
            range: {
              minimum: 0.02
              maximum: 0.15
            }
            increment: 0.001
            unit: "m/s"
          }
          hardware_value_properties: {
            range: {
              minimum: 0
              maximum: 255
            }
            increment: 1
            unit: ""
          }
          default_si_value: 0.02
        }
        effort: {
          si_properties: {
            range: {
              minimum: 20.0
              maximum: 185.0
            }
            increment: 1.0
            unit: "Newton"
          }
          hardware_value_properties: {
            range: {
              minimum: 0
              maximum: 255
            }
            increment: 1
            unit: ""
          }
          default_si_value: 20.0
        }
      }
      additional_config: {
        cyclic_routine_frequency_hz: 10.0
        status_topic: "robotiq_gripper/gripper/status"
      }
      # pinch_gripper_driver_name is the c++ class name of the
      # gripper driver implementation.
      pinch_gripper_driver_name: "RobotiqGripper"
    }
  }
  grpc_config: {
    grpc_timeout: {
      seconds: 10
    }
  }
}
