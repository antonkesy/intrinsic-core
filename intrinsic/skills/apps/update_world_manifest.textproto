id {
  package: "ai.intrinsic"
  name: "update_world"
}
display_name: "Update world"
vendor {
  display_name: "Intrinsic"
}
documentation: {
  description:
    "Performs an object world update.\n"
    "\n"
    "This is a wrapper skill around the ObjectWorldUpdate API.\n"
    "This skill takes an ObjectWorldUpdate as input and applies the\n"
    "specified update to the specified world object or frame in the world.\n"
    "This allows the use of any functionality from ObjectWorldUpdate API via\n"
    "a skill, as part of a behavior tree process.\n"
}
options {
  python_config {
    skill_module: "intrinsic.skills.apps.update_world"
    proto_module: "intrinsic.skills.apps.update_world_pb2"
    create_skill: "intrinsic.skills.apps.update_world.UpdateWorld"
  }
}
parameter {
  message_full_name: "intrinsic_proto.skills.UpdateWorldParams"
}
