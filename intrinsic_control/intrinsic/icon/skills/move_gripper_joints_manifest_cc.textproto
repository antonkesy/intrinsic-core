id {
  package: "ai.intrinsic"
  name: "move_gripper_joints"
}
display_name: "Move gripper joints"
vendor {
  display_name: "Intrinsic"
}
options {
  supports_cancellation: true
  cancellation_ready_timeout {
    seconds: 10
  }
  cc_config {
    create_skill: "::intrinsic::skills::MoveGripperJoints::CreateSkill"
  }
}
dependencies {
  required_equipment {
    key: "gripper"
    value {
      capability_names: "intrinsic_proto.icon.v1.IconApi"
      capability_names: "Icon2PositionPart"
    }
  }
}
parameter {
  message_full_name: "intrinsic_proto.skills.MoveGripperJointsParams"
}
documentation {
  description:
    "Skill to move the gripper joints of an Icon2PositionPart."
    "Uses the ICON Application Layer API to move the joints to a specified"
    "configuration. This skill does not perform collision checking."
}

status_info: [
  {
    code: 10000
    title: "Collision Error"
    recovery_instructions: "Check and fix goal_position."
  },
  {
    code: 10001
    title: "ICON Error"
    recovery_instructions: "Make sure the gripper controller is running."
  },
  {
    code: 10002
    title: "Initial Position Outside Joint Limits Error"
    recovery_instructions: "Move the gripper joints to a valid configuration."
  },
  {
    code: 10003
    title: "Invalid Parameters Error"
    recovery_instructions: "Check that gripper parameters are valid and within limits."
  }
]
