id {
  package: "ai.intrinsic"
  name: "enable_realtime_control"
}
display_name: "Enable real-time control"
vendor {
  display_name: "Intrinsic"
}
documentation {
  description:
    "Enables the real-time control service.\n"
    "\n"
    "The real-time control service typically control robots, fieldbuses and \n"
    "other hardware connected to the real-time PC.\n"
    "This skill is rarely needed because the real-time control service \n"
    "enables automatically on startup and while clearing faults.\n"
    "The only use case is to resume real-time control after a \n"
    "disable_realtime_control call.\n"
}
options {
  supports_cancellation: false
  cc_config {
    create_skill: "::intrinsic::skills::EnableRealtimeControl::CreateSkill"

  }
}
dependencies {
  required_equipment {
    key: "robot"
    value {
      capability_names: "intrinsic_proto.icon.v1.IconApi"
    }
  }
}
parameter {
  message_full_name: "intrinsic_proto.skills.EnableRealtimeControlParams"
  default_value {
    type_url: "type.googleapis.com/intrinsic_proto.skills.EnableRealtimeControlParams"
  }
}
