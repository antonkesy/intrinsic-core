id {
  package: "ai.intrinsic"
  name: "update_robot_joint_positions"
}
display_name: "Update robot joint positions"
vendor {
  display_name: "Intrinsic"
}
documentation {
  description:
    "\n"
    "    The skill reads the joint configuration from a robot and updates the world.\n"
    "    It is intended to be called after the robot has been jogged manually.\n"
}
options {
  cancellation_ready_timeout {
    seconds: 30
  }
  cc_config {
    create_skill: "::intrinsic::skills::UpdateRobotJointPositions::CreateSkill"
  }
}
dependencies {
  required_equipment {
    key: "robot"
    value {
      capability_names: "intrinsic_proto.icon.v1.IconApi"
    }
  }
}
parameter {
  message_full_name: "intrinsic_proto.skills.UpdateRobotJointPositionsParameters"
  default_value {
    [type.googleapis.com/intrinsic_proto.skills.UpdateRobotJointPositionsParameters] {
      part: "arm"
    }
  }
}
