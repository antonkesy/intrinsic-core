id {
  package: "ai.intrinsic"
  name: "aio_set_output"
}
display_name: "AIO set output"
vendor {
  display_name: "Intrinsic"
}
documentation {
  description:
    "This skill can be used to set specific analog outputs."
    " This skill does *not* wait until the values have been set.\n\n"
    "For 'Adio', select the real-time control service that controls the "
    "analog outputs. When the analog output is provided by a robot control box"
    " or EtherCAT, this is usually named 'robot_controller'."
}
options {
  supports_cancellation: false
  cc_config {
    create_skill: "::intrinsic::skills::AioSetOutput::CreateSkill"
  }
}
dependencies {
  required_equipment {
    key: "adio"
    value {
      capability_names: "Icon2AdioPart"
    }
  }
}
parameter {
  message_full_name: "intrinsic_proto.skills.AioSetOutputParams"
}
