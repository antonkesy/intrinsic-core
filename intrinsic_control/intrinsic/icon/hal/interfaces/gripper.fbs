namespace intrinsic_fbs;

enum OpenDirection : uint8 {
  NONE = 0,
  OPEN = 1,
  CLOSE = 2,
}

table GripperCommand {
  width:double = 0;
  speed:double = 0;
  force:double = 0;
  open_direction:OpenDirection = NONE;
}

table GripperStatus {
  width:double = 0;
  temperature:double = 0;
  max_width:double = 0;
  in_error:bool = false;
}
