        min_position: -2.8
        max_position: 2.8
        max_velocity: 1.0
        max_acceleration: 15
        max_jerk: 9000
        max_effort: 100
      }
    }
    joint_system_limits: {
      key: "wrist_1_joint"
      value: {
        min_position: -6.2831853
        max_position: 6.2831853
        max_velocity: 1.0
        max_acceleration: 15
        max_jerk: 9000
        max_effort: 100
      }
    }
    joint_system_limits: {
      key: "wrist_2_joint"
      value: {
        min_position: -6.2831853
        max_position: 6.2831853
        max_velocity: 1.0
        max_acceleration: 15
        max_jerk: 9000
        max_effort: 100
      }
    }
    joint_system_limits: {
      key: "wrist_3_joint"
      value: {
        min_position: -6.2831853
        max_position: 6.2831853
        max_velocity: 1.0
        max_acceleration: 15
        max_jerk: 9000
        max_effort: 100
      }
    }

    # 95% of system limits, rounded down
    joint_application_limits: {
      key: "shoulder_pan_joint"
      value: {
        min_position: -6.2203534
        max_position: 6.2203534
        max_velocity: 0.8
        max_acceleration: 10
        max_jerk: 8001
        max_effort: 100
      }
    }
    joint_application_limits: {
      key: "shoulder_lift_joint"
      value: {
        min_position: -4.059
        max_position: 0.9504
        max_velocity: 0.8
        max_acceleration: 10
        max_jerk: 8001
        max_effort: 100
      }
    }
    joint_application_limits: {
      key: "elbow_joint"
