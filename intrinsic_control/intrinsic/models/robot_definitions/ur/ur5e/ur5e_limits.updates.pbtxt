updates: {
  update_joints {
    joint_positions {
      key: "shoulder_pan_joint"
      value: -1.45
    }
    joint_positions {
      key: "shoulder_lift_joint"
      value: -1.18
    }
    joint_positions {
      key: "elbow_joint"
      value: -2.15
    }
    joint_positions {
      key: "wrist_1_joint"
      value: -1.35
