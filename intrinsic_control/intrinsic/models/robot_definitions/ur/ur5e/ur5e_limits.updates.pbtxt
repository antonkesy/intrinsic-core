    joint_positions {
      key: "wrist_2_joint"
      value: 1.57
    }
    joint_positions {
      key: "wrist_3_joint"
      value: -0.5
    }

    # These velocity limits are significantly below UR5e datasheet values due to
    # saturation behaviour of UR controller above these velocities. Please
    # consult with @sotiropoulos before changing.
    joint_system_limits: {
      key: "shoulder_pan_joint"
      value: {
        min_position: -6.2831853
        max_position: 6.2831853
        max_velocity: 1.0
        max_acceleration: 15
        max_jerk: 9000
        max_effort: 100
      }
    }
    joint_system_limits: {
      key: "shoulder_lift_joint"
