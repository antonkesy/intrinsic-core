        min_position: -2.772
        max_position: 2.772
        max_velocity: 0.8
        max_acceleration: 10
        max_jerk: 8001
        max_effort: 100
      }
    }
    joint_application_limits: {
      key: "wrist_1_joint"
      value: {
        min_position: -6.2203534
        max_position: 6.2203534
        max_velocity: 0.8
        max_acceleration: 10
        max_jerk: 8001
        max_effort: 100
      }
    }
    joint_application_limits: {
