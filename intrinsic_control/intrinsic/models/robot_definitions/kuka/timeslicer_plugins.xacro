<sdf version='1.6' xmlns:xacro='http://www.ros.org/wiki/xacro'>

  <xacro:macro name="timeslicer_plugins" params="prefix:=''
                                                 joint_0_initial:=0
                                                 joint_1_initial:=0
                                                 joint_2_initial:=0
                                                 joint_3_initial:=0
                                                 joint_4_initial:=0
                                                 joint_5_initial:=0
                                                 dio_input_topic:='dio_block_in'
                                                 dio_output_topic:='dio_block_out'">
    <plugin filename="static://intrinsic::simulation::TimeslicerWorld" name="TimeslicerPlugin">
    </plugin>

    <!-- HAL Digital IO Block simulation -->
    <plugin filename="static://intrinsic::simulation::DigitalInputOutput" name="DigitalInputOutput">
      <!-- Kuka robots can have up to 64 input bits, but for now we only support up to 32 bits
           TODO(b/363247945): Increase to 64 once all gazebo plugins use the ECM, rather than an
                              Int32 gz-transport topic, to transmit DIO information.
      -->
      <input_block name="digital_input_status"
                   num_bits="32" />
      <input_block name="digital_output_status"
                   num_bits="32" />
      <output_block name="digital_output_command"
                    num_bits="32" />
    </plugin>

    <!-- Joint simulation -->
    <plugin filename="static://intrinsic::simulation::DeviceContainerPlugin" name="DeviceContainer">
      <device name="axis_0" type="ds402">
        <joint>${prefix}joint_a1</joint>
        <initial>${joint_0_initial}</initial>
      </device>
      <device name="axis_1" type="ds402">
        <joint>${prefix}joint_a2</joint>
        <initial>${joint_1_initial}</initial>
      </device>
      <device name="axis_2" type="ds402">
        <joint>${prefix}joint_a3</joint>
        <initial>${joint_2_initial}</initial>
      </device>
      <device name="axis_3" type="ds402">
        <joint>${prefix}joint_a4</joint>
        <initial>${joint_3_initial}</initial>
      </device>
      <device name="axis_4" type="ds402">
        <joint>${prefix}joint_a5</joint>
        <initial>${joint_4_initial}</initial>
      </device>
      <device name="axis_5" type="ds402">
        <joint>${prefix}joint_a6</joint>
        <initial>${joint_5_initial}</initial>
      </device>
    </plugin>
  </xacro:macro>

</sdf>
