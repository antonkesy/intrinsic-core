<sdf version='1.9' xmlns:xacro='http://www.ros.org/wiki/xacro'>
<xacro:include filename="$(cwd)/intrinsic_control/intrinsic/models/robot_definitions/kuka/kr50_r2500/kr50_r2500_base.xacro"/>
<xacro:include filename="$(cwd)/intrinsic_control/intrinsic/models/robot_definitions/kuka/timeslicer_plugins.xacro"/>

<!-- Expands to an Kuka KR 50 R2500 robot that can be customized with various
  options like starting pose.

  Parameters:
  name: Name of the generated <model>.
  model_options: Additional options for the generated <model>. Example usage:
    <xacro:kr50_r2500_sdf ...>
      <model_options>
        <pose>1 2 3 0 0 0</pose>
      </model_options>
    </xacro:kr50_r2500_sdf>
  joint_*_initial: Initial joint positions of the generated robot (in radians).
-->
<xacro:macro name='kr50_r2500_sdf' params='name
                                     **model_options
                                     joint_0_initial:=0
                                     joint_1_initial:=0
                                     joint_2_initial:=0
                                     joint_3_initial:=0
                                     joint_4_initial:=0
                                     joint_5_initial:=0'>
  <xacro:kr50_r2500_base_sdf name="${name}">
    <model_options>
      <xacro:timeslicer_plugins joint_0_initial="${joint_0_initial}"
                                joint_1_initial="${joint_1_initial}"
                                joint_2_initial="${joint_2_initial}"
                                joint_3_initial="${joint_3_initial}"
                                joint_4_initial="${joint_4_initial}"
                                joint_5_initial="${joint_5_initial}"/>
      <!-- Append passed in model options. -->
      <xacro:insert_block name="model_options"/>
    </model_options>
  </xacro:kr50_r2500_base_sdf>
</xacro:macro>
</sdf>