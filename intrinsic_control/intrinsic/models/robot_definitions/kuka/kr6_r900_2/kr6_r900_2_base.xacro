<sdf version='1.9' xmlns:xacro='http://www.ros.org/wiki/xacro' xmlns:intrinsic='https://intrinsic.ai/'>
  <xacro:property name="default_kr6r900_2_limits_path" value="$(cwd)/intrinsic_control/intrinsic/models/robot_definitions/kuka/kr6_r900_2/kr6_r900_2_limits.yaml"/>
  <xacro:macro name='kr6_r900_2_base_sdf' params='name limits:=${load_yaml(default_kr6r900_2_limits_path)} **model_options'>
    <model name='${name}'>
      <intrinsic:ik_solver>spherical_wrist</intrinsic:ik_solver>
      <intrinsic:cartesian_limits>
        <intrinsic:min_translational_position>-5 -5 -5</intrinsic:min_translational_position>
        <intrinsic:max_translational_position>5 5 5</intrinsic:max_translational_position>
      </intrinsic:cartesian_limits>

      <link name="base_link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>300</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="base_link_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/visual/base.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="base_link_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/collision/base.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a1" type="revolute">
        <pose relative_to="base_link"/>
        <parent>base_link</parent>
        <child>link_1</child>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit>
            <effort>${limits['torque'][0]}</effort>
            <lower>${limits['position']['lower'][0]}</lower>
            <upper>${limits['position']['upper'][0]}</upper>
            <velocity>${limits['velocity'][0]}</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="link_1">
        <pose relative_to='joint_a1'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>400</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="link_1_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/visual/link_1.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="link_1_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/collision/link_1.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a2" type="revolute">
        <pose relative_to="link_1">0.025 0 0.4 0 ${radians(90.0)} 0</pose>
        <parent>link_1</parent>
        <child>link_2</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <effort>${limits['torque'][1]}</effort>
            <lower>${limits['position']['lower'][1]}</lower>
            <upper>${limits['position']['upper'][1]}</upper>
            <velocity>${limits['velocity'][1]}</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="link_2">
        <pose relative_to='joint_a2'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>100</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="link_2_visual">
          <pose>-0.025 0 -0.4 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/visual/link_2.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="link_2_collision">
          <pose>-0.025 0 -0.4 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/collision/link_2.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a3" type="revolute">
        <pose relative_to="link_2">0 0 0.455 0 0 0</pose>
        <parent>link_2</parent>
        <child>link_3</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <effort>${limits['torque'][2]}</effort>
            <lower>${limits['position']['lower'][2]}</lower>
            <upper>${limits['position']['upper'][2]}</upper>
            <velocity>${limits['velocity'][2]}</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="link_3">
        <pose relative_to='joint_a3'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0.28 0 0 0</pose>
          <mass>100</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="link_3_visual">
          <pose>0.855 0 -0.025 0 ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/visual/link_3.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="link_3_collision">
          <pose>0.855 0 -0.025 0 ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/collision/link_3.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a4" type="revolute">
        <pose relative_to="link_3">-0.025 0 0.420 0 0 0</pose>
        <parent>link_3</parent>
        <child>link_4</child>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit>
            <effort>${limits['torque'][3]}</effort>
            <lower>${limits['position']['lower'][3]}</lower>
            <upper>${limits['position']['upper'][3]}</upper>
            <velocity>${limits['velocity'][3]}</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="link_4">
        <pose relative_to='joint_a4'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0.25 0 0 0</pose>
          <mass>100</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="link_4_visual">
          <pose>0.88 0 -0.445 0 ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/visual/link_4.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="link_4_collision">
          <pose>0.88 0 -0.445 0 ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/collision/link_4.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a5" type="revolute">
        <pose relative_to="link_4">0 0 0 ${radians(-90.0)} 0 0</pose>
        <parent>link_4</parent>
        <child>link_5</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <effort>${limits['torque'][4]}</effort>
            <lower>${limits['position']['lower'][4]}</lower>
            <upper>${limits['position']['upper'][4]}</upper>
            <velocity>${limits['velocity'][4]}</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="link_5">
        <pose relative_to='joint_a5'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>100</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="link_5_visual">
          <pose>0.88 0.445 0 ${radians(90.0)} 0 ${radians(-90.0)}</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/visual/link_5.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="link_5_collision">
          <pose>0.88 0.445 0 ${radians(90.0)} 0 ${radians(-90.0)}</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/collision/link_5.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6" type="revolute">
        <pose relative_to="link_5">0 -0.09 0 ${radians(90.0)} 0 0</pose>
        <parent>link_5</parent>
        <child>link_6</child>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit>
            <effort>${limits['torque'][5]}</effort>
            <lower>${limits['position']['lower'][5]}</lower>
            <upper>${limits['position']['upper'][5]}</upper>
            <velocity>${limits['velocity'][5]}</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="link_6">
        <pose relative_to='joint_a6'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>100</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="link_6_visual">
          <pose>0.88 0 -0.535 0 ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/visual/link_6.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="link_6_collision">
          <pose>0.88 0 -0.535 0 ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr6_r900_2/collision/link_6.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6_tool0" type="fixed">
        <parent>link_6</parent>
        <child>tool0</child>
        <pose relative_to="link_6">0 0 0 0 0 0</pose>
      </joint>
      <link name='tool0'>
        <pose relative_to='joint_a6_tool0'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>100</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
      </link>

      <frame name='flange' attached_to='tool0' intrinsic:create_attachment_entity='true'/>
      <xacro:insert_block name='model_options'/>

    </model>
  </xacro:macro>
</sdf>
