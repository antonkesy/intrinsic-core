<sdf version='1.9' xmlns:xacro='http://www.ros.org/wiki/xacro' xmlns:intrinsic='https://intrinsic.ai/'>
  <xacro:macro name='kr20_r1810_2_base_sdf' params='name **model_options'>
    <model name='${name}'>
      <intrinsic:ik_solver>spherical_wrist</intrinsic:ik_solver>
      <intrinsic:cartesian_limits>
        <intrinsic:min_translational_position>-5 -5 -5</intrinsic:min_translational_position>
        <intrinsic:max_translational_position>5 5 5</intrinsic:max_translational_position>
      </intrinsic:cartesian_limits>

    TODO(b/304158474)

      <link name="base_link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>300</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="base_link_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/visual/base_link.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="base_link_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/collision/base_link.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a1" type="revolute">
        <pose relative_to="base_link"/>
        <parent>base_link</parent>
        <child>link_1</child>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit>
            <effort>200</effort>
            <lower>${radians(-185)}</lower>
            <upper>${radians(185)}</upper>
            <velocity>${radians(200.0)}</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="link_1">
        <pose relative_to='joint_a1'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>400</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="link_1_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/visual/link_1.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="link_1_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/collision/link_1.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a2" type="revolute">
        <pose relative_to="link_1">0.16 0 0.52 0 ${radians(90.0)} 0</pose>
        <parent>link_1</parent>
        <child>link_2</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <effort>200</effort>
            <lower>${radians(-185.0)}</lower>
            <upper>${radians(65)}</upper>
            <velocity>${radians(175.0)}</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="link_2">
        <pose relative_to='joint_a2'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>100</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="link_2_visual">
          <pose>-0.16 0 -0.52 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/visual/link_2.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="link_2_collision">
          <pose>-0.16 0 -0.52 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/collision/link_2.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a3" type="revolute">
        <pose relative_to="link_2">0 0 0.78 0 0 0</pose>
        <parent>link_2</parent>
        <child>link_3</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <effort>200</effort>
            <lower>${radians(-138)}</lower>
            <upper>${radians(175)}</upper>
            <velocity>${radians(190.0)}</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="link_3">
        <pose relative_to='joint_a3'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0.28 0 0 0</pose>
          <mass>100</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="link_3_visual">
          <pose>1.3 0 -0.16 0 ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/visual/link_3.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="link_3_collision">
          <pose>1.3 0 -0.16 0 ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/collision/link_3.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a4" type="revolute">
        <pose relative_to="link_3">-0.15 0 0.86 0 0 0</pose>
        <parent>link_3</parent>
        <child>link_4</child>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit>
            <effort>200</effort>
            <lower>${radians(-350.0)}</lower>
            <upper>${radians(350.0)}</upper>
            <velocity>${radians(430.0)}</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="link_4">
        <pose relative_to='joint_a4'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0.25 0 0 0</pose>
          <mass>100</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="link_4_visual">
          <pose>1.45 0 -1.02 0 ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/visual/link_4.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="link_4_collision">
          <pose>1.45 0 -1.02 0 ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/collision/link_4.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a5" type="revolute">
        <pose relative_to="link_4">0 0 0 ${radians(-90.0)} 0 0</pose>
        <parent>link_4</parent>
        <child>link_5</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <effort>200</effort>
            <lower>${radians(-130)}</lower>
            <upper>${radians(130)}</upper>
            <velocity>${radians(430.0)}</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="link_5">
        <pose relative_to='joint_a5'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>100</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="link_5_visual">
          <pose>1.45 1.02 0 ${radians(90.0)} 0 ${radians(-90.0)}</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/visual/link_5.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="link_5_collision">
          <pose>1.45 1.02 0 ${radians(90.0)} 0 ${radians(-90.0)}</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/collision/link_5.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6" type="revolute">
        <pose relative_to="link_5">0 -0.153 0 ${radians(90.0)} 0 0</pose>
        <parent>link_5</parent>
        <child>link_6</child>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit>
            <effort>200</effort>
            <lower>${radians(-350)}</lower>
            <upper>${radians(350)}</upper>
            <velocity>${radians(630.0)}</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <link name="link_6">
        <pose relative_to='joint_a6'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>100</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="link_6_visual">
          <pose>1.45 0 -1.173 0 ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/visual/link_6.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="link_6_collision">
          <pose>1.45 0 -1.173 0 ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/kuka/kr20_r1810_2/collision/link_6.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6_tool0" type="fixed">
        <parent>link_6</parent>
        <child>tool0</child>
        <pose relative_to="link_6">0 0 0 0 0 0</pose>
      </joint>
      <link name='tool0'>
        <pose relative_to='joint_a6_tool0'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>100</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
      </link>

      <frame name='flange' attached_to='tool0' intrinsic:create_attachment_entity='true'/>
      <xacro:insert_block name='model_options'/>

    </model>
  </xacro:macro>
</sdf>
