<sdf version='1.9' xmlns:xacro='http://www.ros.org/wiki/xacro'>
<xacro:include filename="$(cwd)/intrinsic_control/intrinsic/models/robot_definitions/abb/irb1300_10_115/irb1300_10_115_base.xacro"/>

<!-- Expands to an abb irb1300_10_115 robot that can be customized with various
  options like starting pose.

  Parameters:
  name: Name of the generated <model>.
  model_options: Additional options for the generated <model>. Example usage:
    <xacro:irb1300_10_115_sdf ...>
      <model_options>
        <pose>1 2 3 0 0 0</pose>
      </model_options>
    </xacro:irb1300_10_115_sdf>
-->
<xacro:macro name='irb1300_10_115_sdf' params='name
                                     **model_options'>
  <xacro:irb1300_10_115_base_sdf name="${name}">
    <model_options>
      <!-- Append passed in model options. -->
      <xacro:insert_block name="model_options"/>
    </model_options>
  </xacro:irb1300_10_115_base_sdf>
</xacro:macro>
</sdf>
