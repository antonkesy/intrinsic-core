# PLEASE NOTE: The joint position limits are for the increased joint_a1
# range option (185 degrees instead of 170 degrees) and the "Conventional
# dress-out type". Limits were taken from the "Fanuc Robot M-20iD Mechanical
# Unit Operator's Manual".
#
# Velocity, acceleration and jerk limits were read out from the
# `read_fanuc_limits` tool and scaled back by approximately 5%. The effort
# limits are not meaningful and placeholder values.
updates: {
  update_joints {
    joint_system_limits: {
      key: "joint_a1"
      value: {
        min_position: -3.228859116  # -185 degrees
        max_position: 3.228859116  # 185 degrees
        max_velocity: 2.9
        max_acceleration: 7.9
        max_jerk: 43
        max_effort: 100
      }
    }
    joint_system_limits: {
      key: "joint_a2"
      value: {
        min_position: -1.74533  # -100 degrees
        max_position: 2.79253  # 160 degrees
        max_velocity: 1.4
        max_acceleration: 3.9
        max_jerk: 21
        max_effort: 100
      }
    }
    joint_system_limits: {
