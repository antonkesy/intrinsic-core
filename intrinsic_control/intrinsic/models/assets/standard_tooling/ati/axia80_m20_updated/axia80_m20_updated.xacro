<sdf version="1.10" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:intrinsic="https://intrinsic.ai/">

  <!-- adapter_offset is the effective length that the adapter adds to the endeffector -->
  <xacro:property name="adapter_offset" value="0.0254"/>
  <xacro:property name="sensor_radius" value="0.041"/>
  <xacro:property name="sensor_mass" value="0.3"/>

  <xacro:macro name="axia80_m20_updated" params="name *pose">
    <model name="${name}">
      <xacro:insert_block name="pose"/>
      <link name="base_link">
        <inertial>
          <pose>0 0 ${adapter_offset / 2} 0 0 0</pose>
          <mass>${sensor_mass}</mass>
          <inertia>
            <ixx>${1/12 * sensor_mass * (3 * sensor_radius**2 + adapter_offset**2)}</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>${1/12 * sensor_mass * (3 * sensor_radius**2 + adapter_offset**2)}</iyy>
            <iyz>0</iyz>
            <izz>${1/2 * sensor_mass * sensor_radius**2}</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="attach_joint" type="fixed">
        <pose relative_to="base_link">0 0 ${adapter_offset} 0 0 0</pose>
        <parent>base_link</parent>
        <child>tool_link</child>
        <sensor name="AtiForceTorqueSensor" type="force_torque">
          <pose>0 0 0 0 0 0</pose>
          <force_torque>
            <!-- Set to ensure forces are expressed in `AtiForceTorqueSensor`-->
            <frame>sensor</frame>
            <!-- Realistic noise as measured in ATI Mini 45 hardware experiments. -->
            <force>
              <x>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.2</stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.2</stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.2</stddev>
                </noise>
              </z>
            </force>
            <torque>
              <x>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.05</stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.05</stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.05</stddev>
                </noise>
              </z>
            </torque>
          </force_torque>
          <always_on>1</always_on>
          <visualize>1</visualize>
          <topic>/9105_axia80_m20/wrench</topic>
        </sensor>
      </joint>
      <link name="tool_link">
        <pose relative_to="attach_joint">0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>0.000001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000001</iyy>
            <iyz>0</iyz>
            <izz>0.000001</izz>
          </inertia>
        </inertial>

        <!-- Visual and collision geo are positioned relative to the base_link because this is where
        the origin of the visual mesh is located. Collision geo must be placed on the tool link
        instead of the base link for collisions with the F/T sensor body to be reported as contact
        force by the sensor. -->

        <visual name="visual">
          <pose relative_to="base_link">0 0 0 0 0 ${-pi/2}</pose>
          <geometry>
            <mesh>
              <uri>model://intrinsic_control/intrinsic/models/assets/standard_tooling/ati/axia80_m20_updated/base_visual.glb</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision1">
          <pose relative_to="base_link">0 0 ${adapter_offset / 2} 0 0 0</pose>
          <geometry>
            <cylinder>
              <length>${adapter_offset}</length>
              <radius>${sensor_radius}</radius>
            </cylinder>
          </geometry>
          <surface>
            <contact>
              <ode>
                <!-- TODO: b/269605353 - Reduce contact stiffness and damping for better stability.
                     Contact giftthaler@ before editing. -->
                <kp>100000</kp>
                <kd>100</kd>
              </ode>
            </contact>
            <friction>
              <ode>
                <!-- Reduce friction in order to get smoother simulated force.
                     Do not modify unless you know exactly what you doing. -->
                <mu>0.01</mu>
                <mu2>0.01</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <!-- Radial M12 cable connector colliders (hex nut and gland barrel) from CAD export
             (Axia80 M20/model.sdf: cylinder001_collider_cylinder at (0, -0.041743, 0.006967) and
             cylinder002_collider_cylinder at (0, -0.04371, 0.006967)), rotated by -pi/2 around Z
             to align the cable gland along -X matching base_visual.glb and the legacy model. -->
        <collision name="collision2">
          <pose relative_to="base_link">-0.041743 0.0 0.006967 ${pi/2} ${pi/6} ${-pi/2}</pose>
          <geometry>
            <cylinder>
              <radius>0.005749</radius>
              <length>0.003149</length>
            </cylinder>
          </geometry>
        </collision>
        <collision name="collision3">
          <pose relative_to="base_link">-0.04371 0.0 0.006967 ${pi/2} 0.0 ${-pi/2}</pose>
          <geometry>
            <cylinder>
              <radius>0.004025</radius>
              <length>0.012963</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
      <frame name="tool_attach" attached_to="tool_link" intrinsic:create_attachment_entity="true">
        <pose relative_to="tool_link">0 0 0 0 0 0</pose>
      </frame>
    </model>
  </xacro:macro>
</sdf>
