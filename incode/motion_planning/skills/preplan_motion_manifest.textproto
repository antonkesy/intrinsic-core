id {
  package: "ai.intrinsic"
  name: "preplan_motion"
}
display_name: "Preplan motion"
vendor {
  display_name: "Intrinsic"
}
documentation {
  description:
    "This skill \"simulates\" a series of motion related skill calls,\n"
    "and triggers the motion plannings as they would be done in actual execution.\n"
    "Doing this warms the motion planning service cache, which may reduce the\n"
    "motion planning times in actual execution.\n"
    "\n"
    "An example process could be:\n"
    "                 Parallel\n"
    "   preplan_motion           update_world\n"
    "                            move_robot\n"
    "                            attach_object_to_robot\n"
    "                            move_robot\n"
    "                            detach_object\n"
    "                            move_robot\n"
}
options {
  cancellation_ready_timeout {
    seconds: 600
  }
  cc_config {
    create_skill: "::intrinsic::skills::PreplanMotionSkill::CreateSkill"
  }
}
dependencies {
  required_equipment {
    key: "robot"
    value {
      capability_names: "intrinsic_proto.icon.v1.IconApi"
      capability_names: "Icon2PositionPart"
    }
  }
}
parameter {
  message_full_name: "intrinsic_proto.skills.PreplanMotionParams"
}
