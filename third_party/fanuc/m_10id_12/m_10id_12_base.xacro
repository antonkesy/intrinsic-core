<sdf version='1.9' xmlns:xacro='http://www.ros.org/wiki/xacro' xmlns:intrinsic='https://intrinsic.ai/'>
  <xacro:macro name='m_10id_12_base_sdf' params='name **model_options'>
    <model name='${name}'>
      <intrinsic:ik_solver>spherical_wrist</intrinsic:ik_solver>
      <intrinsic:control_frequency_hz>250</intrinsic:control_frequency_hz>
      <intrinsic:cartesian_limits>
        <intrinsic:min_translational_position>-5 -5 -5</intrinsic:min_translational_position>
        <intrinsic:max_translational_position>5 5 5</intrinsic:max_translational_position>
        <intrinsic:min_translational_velocity>-2 -2 -2</intrinsic:min_translational_velocity>
        <intrinsic:max_translational_velocity>2 2 2</intrinsic:max_translational_velocity>
        <intrinsic:min_translational_jerk>-150 -150 -150</intrinsic:min_translational_jerk>
        <intrinsic:max_translational_jerk>150 150 150</intrinsic:max_translational_jerk>
        <intrinsic:max_rotational_jerk>100</intrinsic:max_rotational_jerk>
      </intrinsic:cartesian_limits>

      <!-- Please note that all inertias are approximated assuming uniform
      density of linkages and dividing the total mass (145kg) of the robot-->
      <link name="base_link">
        <inertial>
          <mass>50.4</mass>
          <pose>0.00757 -0.0212 0.138 0 0 0</pose>
          <inertia>
            <ixx>0.83</ixx>
            <ixy>0.034</ixy>
            <ixz>-0.0292</ixz>
            <iyy>0.83</iyy>
            <iyz>0.0553</iyz>
            <izz>0.999</izz>
          </inertia>
        </inertial>
        <visual name='base_link_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/visual/base.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='base_link_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/collision/base.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a1" type="revolute">
        <pose relative_to="base_link">0 0 0 0 0 0</pose>
        <parent>base_link</parent>
        <child>link_1</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
      </joint>
      <link name="link_1">
        <pose relative_to='joint_a1'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>26.4</mass>
          <pose>0.0385 -0.0176 0.4141 0 0 0</pose>
          <inertia>
            <ixx>0.299</ixx>
            <ixy>-0.0111</ixy>
            <ixz>-0.0165</ixz>
            <iyy>0.254</iyy>
            <iyz>-0.00943</iyz>
            <izz>0.352</izz>
          </inertia>
        </inertial>
        <visual name='link_1_visual'>
          <pose>0 0 0.45 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/visual/j1.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_1_collision'>
          <pose>0 0 0.45 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/collision/j1.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a2" type="revolute">
        <pose relative_to="link_1">0.075 0 0.450 0 0 0</pose>
        <parent>link_1</parent>
        <child>link_2</child>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
      </joint>
      <link name="link_2">
        <pose relative_to='joint_a2'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>25.9</mass>
          <pose>-0.0225 -0.149 0.305 0 0 0</pose>
          <inertia>
            <ixx>1.1</ixx>
            <ixy>-0.0175</ixy>
            <ixz>0.0117</ixz>
            <iyy>1.12</iyy>
            <iyz>-0.0237</iyz>
            <izz>0.112</izz>
          </inertia>
        </inertial>
        <visual name='link_2_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/visual/j2.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_2_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/collision/j2.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a3" type="revolute">
        <pose relative_to="link_2">0 0 0.64 0 0 0</pose>
        <parent>link_2</parent>
        <child>link_3</child>
        <axis>
          <xyz>0 -1 0</xyz>
        </axis>
      </joint>
      <link name="link_3">
        <pose relative_to='joint_a3'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>31.2</mass>
          <pose>0.11 0.00824 0.0948 0 0 0</pose>
          <inertia>
            <ixx>0.453</ixx>
            <ixy>-0.0272</ixy>
            <ixz>-0.101</ixz>
            <iyy>0.413</iyy>
            <iyz>-0.0247</iyz>
            <izz>0.415</izz>
          </inertia>
        </inertial>
        <visual name='link_3_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/visual/j3.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_3_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/collision/j3.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a4" type="revolute">
        <pose relative_to="link_3">0 0 0.195 0 0 0</pose>
        <parent>link_3</parent>
        <child>link_4</child>
        <axis>
          <xyz>-1 0 0</xyz>
        </axis>
      </joint>
      <link name="link_4">
        <pose relative_to='joint_a4'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>9.7</mass>
          <pose>0.457 -0.0439 -0.00116 0 0 0</pose>
          <inertia>
            <ixx>0.027</ixx>
            <ixy>0.0159</ixy>
            <ixz>-0.00073</ixz>
            <iyy>0.161</iyy>
            <iyz>-0.000234</iyz>
            <izz>0.169</izz>
          </inertia>
        </inertial>
        <visual name='link_4_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/visual/j4.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_4_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/collision/j4.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a5" type="revolute">
        <pose relative_to="link_4">0.700 0 0 0 0 0 </pose>
        <parent>link_4</parent>
        <child>link_5</child>
        <axis>
          <xyz>0 -1 0</xyz>
        </axis>
      </joint>
      <link name="link_5">
        <pose relative_to='joint_a5'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>1.22</mass>
          <pose>0.0214 -0.015 4.94e-11 0 0 0</pose>
          <inertia>
            <ixx>0.00182</ixx>
            <ixy>-0.000412</ixy>
            <ixz>1.63e-12</ixz>
            <iyy>0.00201</iyy>
            <iyz>1.48e-12</iyz>
            <izz>0.00198</izz>
          </inertia>
        </inertial>
        <visual name='link_5_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/visual/j5.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_5_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/collision/j5.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6" type="revolute">
        <pose relative_to="link_5">0.075 0 0 0 ${radians(-90)} ${radians(180)}</pose>
        <parent>link_5</parent>
        <child>link_6</child>
        <axis>
          <xyz>0 0 -1</xyz>
        </axis>
      </joint>
      <link name="link_6">
        <pose relative_to='joint_a6'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.235</mass>
          <pose>0.00000541 -0.000000457 -0.0213 0 0 0</pose>
          <inertia>
            <ixx>0.000107</ixx>
            <ixy>4.17e-12</ixy>
            <ixz>-0.00000000839</ixz>
            <iyy>0.000107</iyy>
            <iyz>0.000000000121</iyz>
            <izz>0.000137</izz>
          </inertia>
        </inertial>
        <visual name='link_6_visual'>
          <pose>0 0 -0.075 ${radians(180.0)} ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/visual/j6.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_6_collision'>
          <pose>0 0 -0.075 ${radians(180.0)} ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_10id_12/collision/j6.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6_tool0" type="fixed">
        <parent>link_6</parent>
        <child>tool0</child>
        <pose relative_to="link_6">0 0 0 0 0 0</pose>
      </joint>
      <link name='tool0'>
        <pose relative_to='joint_a6_tool0'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
        </inertial>
      </link>

      <frame name='flange' attached_to='tool0' intrinsic:create_attachment_entity='true'/>
      <xacro:insert_block name='model_options'/>

    </model>
  </xacro:macro>
</sdf>
