<sdf version='1.9' xmlns:xacro='http://www.ros.org/wiki/xacro' xmlns:intrinsic='https://intrinsic.ai/'>
  <xacro:macro name='lr_10ia_10_base_sdf' params='name **model_options'>
    <model name='${name}'>
    <intrinsic:ik_solver>spherical_wrist</intrinsic:ik_solver>
    <intrinsic:cartesian_limits>
      <intrinsic:min_translational_position>-5 -5 -5</intrinsic:min_translational_position>
      <intrinsic:max_translational_position>5 5 5</intrinsic:max_translational_position>
      <!-- Read from the robot system variable $STMO_GRP[1].$MAX_SPD. If we would go faster,
      FANUC decreases the ACC/JERK limit further on the fly.-->
      <intrinsic:min_translational_velocity>-4 -4 -4</intrinsic:min_translational_velocity>
      <intrinsic:max_translational_velocity>4 4 4</intrinsic:max_translational_velocity>
      <intrinsic:min_translational_jerk>-150 -150 -150</intrinsic:min_translational_jerk>
      <intrinsic:max_translational_jerk>150 150 150</intrinsic:max_translational_jerk>
      <intrinsic:max_rotational_jerk>100</intrinsic:max_rotational_jerk>
    </intrinsic:cartesian_limits>

      <!-- Please note that all inertias are approximated assuming uniform density of linkages-->
      <link name="base_link">
        <inertial>
          <mass>8.31</mass>
          <pose>-0.0229 0.0000229 0.0978 0 0 0</pose>
          <inertia>
            <ixx>0.0534</ixx>
            <ixy>-0.0000114</ixy>
            <ixz>-0.00191</ixz>
            <iyy>0.0716</iyy>
            <iyz>0.000000707</iyz>
            <izz>0.0713</izz>
          </inertia>
        </inertial>
        <visual name='base_link_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_10ia_10/visual/base.dae</uri>
            </mesh>
          </geometry>
        </visual>

        <collision name ="base_link_collision_cylinder">
          <pose>-0.006282247602939606 5.51673640103445e-09 0.10190088301897049 0.0 -0.0 -8.781469205132453e-07</pose>
          <geometry>
            <cylinder>
              <length>0.20820079743862152</length>
              <radius>0.12411808967590332</radius>
            </cylinder>
          </geometry>
        </collision>
        <collision name ="base_link_collision_cube_001">
          <pose>-0.12560710310935974 1.96013960618302e-09 0.09849999845027924 -1.5707963705062866 -0.0 1.5707963705062866</pose>
          <geometry>
            <box>
              <size>0.14300000667572021 0.18700000643730164 0.04718669503927231</size>
            </box>
          </geometry>
        </collision>
        <collision name ="base_link_collision_cube_002">
          <pose>0.0 1.0475591505354487e-09 0.01198267936706543 -3.1415927410125732 -0.0 0.0</pose>
          <geometry>
            <box>
              <size>0.21400000154972076 0.21400000154972076 0.02396537736058235</size>
            </box>
          </geometry>
        </collision>
        <collision name="base_cable_collision">
          <pose>-0.20 0 0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>0.140 0.180 0.068</size>
            </box>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a1" type="revolute">
        <pose relative_to="base_link">0 0 0.201 0 0 0</pose>
        <parent>base_link</parent>
        <child>link_1</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
      </joint>
      <link name="link_1">
        <pose relative_to='joint_a1'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>11.1</mass>
          <pose>0.0144 0.000328 0.1373 0 0 0</pose>
          <inertia>
            <ixx>0.131</ixx>
            <ixy>0.000236</ixy>
            <ixz>-0.00678</ixz>
            <iyy>0.0941</iyy>
            <iyz>0.0000713</iyz>
            <izz>0.0986</izz>
          </inertia>
        </inertial>
        <visual name='link_1_visual'>
          <pose>0 0 0.199 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_10ia_10/visual/j1.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_1_collision'>
          <pose>0 0 0.199 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_10ia_10/collision/j1.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a2" type="revolute">
          <pose relative_to="link_1">0.025 0 0.1975 ${radians(90.0)} ${radians(180.0)} 0 </pose>
        <parent>link_1</parent>
        <child>link_2</child>
        <axis>
          <xyz>0 0 -1</xyz>
        </axis>
      </joint>
      <link name="link_2">
        <pose relative_to='joint_a2'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>19.6</mass>
          <pose>0.000213 -0.2665 -0.000368 0 0 0</pose>
          <inertia>
            <ixx>0.824</ixx>
            <ixy>0.000158</ixy>
            <ixz>0.0000957</ixz>
            <iyy>0.122</iyy>
            <iyz>0.000447</iyz>
            <izz>0.776</izz>
          </inertia>
        </inertial>
        <visual name='link_2_visual'>
          <pose>0 -0.0015 0 ${radians(-90.0)} 0 ${radians(180.0)}</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_10ia_10/visual/j2.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_2_collision'>
          <pose>0 -0.0015 0 ${radians(-90.0)} 0 ${radians(180.0)}</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_10ia_10/collision/j2.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a3" type="revolute">
        <pose relative_to="link_2">0 -0.56 0 0 0 ${radians(180.0)}</pose>
        <parent>link_2</parent>
        <child>link_3</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
      </joint>
      <link name="link_3">
        <pose relative_to='joint_a3'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>2.5</mass>
          <pose>0.00103 0.00925 -0.00127 0 0 0</pose>
          <inertia>
            <ixx>0.00715</ixx>
            <ixy>-0.000983</ixy>
            <ixz>0.0000906</ixz>
            <iyy>0.00942</iyy>
            <iyz>-0.000000123</iyz>
            <izz>0.00978</izz>
          </inertia>
        </inertial>
        <visual name='link_3_visual'>
          <pose>0 0.0015 0 ${radians(-90.0)} 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_10ia_10/visual/j3.dae</uri>
            </mesh>
          </geometry>
        </visual>

        <collision name ="link_3_collision">
          <pose>0.001656827051192522 0.01107268687337637 -0.004499976057559252 -8.202754315789207e-07 8.047754107565197e-08 -3.14077091217041</pose>
          <geometry>
            <box>
              <size>0.1928088665008545 0.1537788063287735 0.14300008118152618</size>
            </box>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a4" type="revolute">
        <pose relative_to="link_3">0.097 0.035 0 ${radians(90.0)} 0 ${radians(90.0)} </pose>
        <parent>link_3</parent>
        <child>link_4</child>
        <axis>
          <xyz>0 0 -1</xyz>
        </axis>
      </joint>
      <link name="link_4">
        <pose relative_to='joint_a4'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>4.09</mass>
          <pose>0.002394 0.0000617 0.235 0 0 0</pose>
          <inertia>
            <ixx>0.0685</ixx>
            <ixy>-0.00000872</ixy>
            <ixz>0.000045</ixz>
            <iyy>0.0669</iyy>
            <iyz>0.00000848</iyz>
            <izz>0.00759</izz>
          </inertia>
        </inertial>
        <visual name='link_4_visual'>
          <pose>0.0015 0 -0.097 ${radians(180.0)} ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_10ia_10/visual/j4.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_4_collision'>
          <pose>0.0015 0 -0.097 ${radians(180.0)} ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_10ia_10/collision/j4.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a5" type="revolute">
        <pose relative_to="link_4">0 0 0.418 ${radians(-90.0)} ${radians(-90.0)} 0</pose>
        <parent>link_4</parent>
        <child>link_5</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
      </joint>
      <link name="link_5">
        <pose relative_to='joint_a5'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.4</mass>
          <pose>0.0184 0.00149562 -0.00109 0 0 0</pose>
          <inertia>
            <ixx>0.000291</ixx>
            <ixy>-0.0000000209</ixy>
            <ixz>-0.00000831</ixz>
            <iyy>0.000495</iyy>
            <iyz>0.0000000136</iyz>
            <izz>0.000539</izz>
          </inertia>
        </inertial>
        <visual name='link_5_visual'>
          <pose>0 0.0015 0 ${radians(-90.0)} 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_10ia_10/visual/j5.dae</uri>
            </mesh>
          </geometry>
        </visual>

        <collision name ="link_5_collision_cylinder_001">
          <pose>-1.0103355634782929e-05 -9.934260742738843e-05 -0.00038650259375572205 3.141592502593994 4.677462683844169e-08 -1.0014257431030273</pose>
          <geometry>
            <cylinder>
              <length>0.061223454773426056</length>
              <radius>0.043629951775074005</radius>
            </cylinder>
          </geometry>
        </collision>
        <collision name ="link_5_collision_cylinder_002">
          <pose>0.05149475485086441 0.0001573501795064658 9.995820437325165e-05 -1.5707963705062866 -0.5037879943847656 -1.5707963705062866</pose>
          <geometry>
            <cylinder>
              <length>0.04876701906323433</length>
              <radius>0.03598254919052124</radius>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6" type="revolute">
        <pose relative_to="link_5">0.080 0 0 0 ${radians(90.0)} 0</pose>
        <parent>link_5</parent>
        <child>link_6</child>
        <axis>
          <xyz>0 0 -1</xyz>
        </axis>
      </joint>
      <link name="link_6">
        <pose relative_to='joint_a6'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.0126</mass>
          <pose>0 0.0015 -0.006 0 0 0</pose>
          <inertia>
            <ixx>0.00000144</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00000144</iyy>
            <iyz>0</iyz>
            <izz>0.00000258</izz>
          </inertia>
        </inertial>
        <visual name='link_6_visual'>
          <pose>0 0.0015 -0.08 ${radians(-90.0)} ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_10ia_10/visual/j6.dae</uri>
            </mesh>
          </geometry>
        </visual>

        <collision name ="link_6_visual_collision">
          <pose>-3.4514814615249634e-06 0.0 -0.006000000052154064 0.0 0.0 0.0</pose>
          <geometry>
            <cylinder>
              <length>0.014000002294778824</length>
              <radius>0.021402286365628242</radius>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6_tool0" type="fixed">
        <parent>link_6</parent>
        <child>tool0</child>
        <pose relative_to="link_6">0 0 0 0 0 ${radians(90)}</pose>
      </joint>
      <link name='tool0'>
        <pose relative_to='joint_a6_tool0'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000015</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000015</iyy>
            <iyz>0</iyz>
            <izz>0.000022</izz>
          </inertia>
        </inertial>
      </link>

      <frame name='flange' attached_to='tool0' intrinsic:create_attachment_entity='true'/>
      <xacro:insert_block name='model_options'/>

    </model>
  </xacro:macro>
</sdf>
