<sdf version='1.9' xmlns:xacro='http://www.ros.org/wiki/xacro' xmlns:intrinsic='https://intrinsic.ai/'>
  <xacro:macro name='lr_mate_200id_4s_base_sdf' params='name **model_options'>
    <model name='${name}'>
      <intrinsic:ik_solver>spherical_wrist</intrinsic:ik_solver>
      <intrinsic:control_frequency_hz>250</intrinsic:control_frequency_hz>
      <intrinsic:cartesian_limits>
        <intrinsic:min_translational_position>-5 -5 -5</intrinsic:min_translational_position>
        <intrinsic:max_translational_position>5 5 5</intrinsic:max_translational_position>
        <!-- Read from the robot system variable $STMO_GRP[1].$MAX_SPD. If we would go faster,
        FANUC decreases the ACC/JERK limit further on the fly.-->
        <intrinsic:min_translational_velocity>-4 -4 -4</intrinsic:min_translational_velocity>
        <intrinsic:max_translational_velocity>4 4 4</intrinsic:max_translational_velocity>
        <intrinsic:min_translational_jerk>-150 -150 -150</intrinsic:min_translational_jerk>
        <intrinsic:max_translational_jerk>150 150 150</intrinsic:max_translational_jerk>
        <intrinsic:max_rotational_jerk>100</intrinsic:max_rotational_jerk>
      </intrinsic:cartesian_limits>

      <!-- Mass parameters are taken from the $PARAM_GROUP[1].$LINK_M system
      variable on the controller. -->
      <link name="base_link">
        <inertial>
          <mass>5.15</mass>
          <pose>-0.0281 0.00396 0.0799 0 0 0</pose>
          <inertia>
            <ixx>0.0219</ixx>
            <ixy>-0.00106</ixy>
            <ixz>-0.000067</ixz>
            <iyy>0.0301</iyy>
            <iyz>0.0000847</iyz>
            <izz>0.0295</izz>
          </inertia>
        </inertial>
        <visual name='base_link_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/visual/base.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='base_link_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/collision/base.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a1" type="revolute">
        <pose relative_to="base_link">0 0 0.330 0 0 0</pose>
        <parent>base_link</parent>
        <child>link_1</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
      </joint>
      <link name="link_1">
        <pose relative_to='joint_a1'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>4.17</mass>
          <pose>0.00151 0.000041 -0.0578 0 0 0</pose>
          <inertia>
            <ixx>0.0252</ixx>
            <ixy>-0.00000663</ixy>
            <ixz>0.000264</ixz>
            <iyy>0.019</iyy>
            <iyz>0.0000011</iyz>
            <izz>0.0162</izz>
          </inertia>
        </inertial>
        <visual name='link_1_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/visual/j1.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_1_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/collision/j1.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a2" type="revolute">
        <pose relative_to="link_1">0.0 0 0.0 0 0 0</pose>
        <parent>link_1</parent>
        <child>link_2</child>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
      </joint>
      <link name="link_2">
        <pose relative_to='joint_a2'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>6.67</mass>
          <pose>-0.00721 -0.000956 0.13 0 0 0</pose>
          <inertia>
            <ixx>0.0769</ixx>
            <ixy>0.0000572</ixy>
            <ixz>-0.000476</ixz>
            <iyy>0.0672</iyy>
            <iyz>-0.000635</iyz>
            <izz>0.0252</izz>
          </inertia>
        </inertial>
        <visual name='link_2_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/visual/j2.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_2_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/collision/j2.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a3" type="revolute">
        <pose relative_to="link_2">0 0 0.260 0 0 0</pose>
        <parent>link_2</parent>
        <child>link_3</child>
        <axis>
          <xyz>0 -1 0</xyz>
        </axis>
      </joint>
      <link name="link_3">
        <pose relative_to='joint_a3'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>1.66</mass>
          <pose>-0.00781 -0.00446 -0.00000291 0 0 0</pose>
          <inertia>
            <ixx>0.00369</ixx>
            <ixy>0.000000468</ixy>
            <ixz>-0.000423</ixz>
            <iyy>0.00425</iyy>
            <iyz>-0.0000116</iyz>
            <izz>0.00414</izz>
          </inertia>
        </inertial>
        <visual name='link_3_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/visual/j3.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_3_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/collision/j3.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a4" type="revolute">
        <pose relative_to="link_3">0 0 0.020 0 0 0</pose>
        <parent>link_3</parent>
        <child>link_4</child>
        <axis>
          <xyz>-1 0 0</xyz>
        </axis>
      </joint>
      <link name="link_4">
        <pose relative_to='joint_a4'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>1.95</mass>
          <pose>0.187 0.00165 0.00184 0 0 0</pose>
          <inertia>
            <ixx>0.00266</ixx>
            <ixy>0.00000358</ixy>
            <ixz>0.0000703</ixz>
            <iyy>0.0115</iyy>
            <iyz>-0.0000074</iyz>
            <izz>0.0116</izz>
          </inertia>
        </inertial>
        <visual name='link_4_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/visual/j4.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_4_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/collision/j4.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a5" type="revolute">
        <pose relative_to="link_4">0.290 0 0 0 0 0 </pose>
        <parent>link_4</parent>
        <child>link_5</child>
        <axis>
          <xyz>0 -1 0</xyz>
        </axis>
      </joint>
      <link name="link_5">
        <pose relative_to='joint_a5'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.39</mass>
          <pose>0.0172 0.000903 -0.00000423 0 0 0</pose>
          <inertia>
            <ixx>0.000268</ixx>
            <ixy>0.00000599</ixy>
            <ixz>-0.0000000104</ixz>
            <iyy>0.000453</iyy>
            <iyz>-0.0000000172</iyz>
            <izz>0.000425</izz>
          </inertia>
        </inertial>
        <visual name='link_5_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/visual/j5.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_5_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/collision/j5.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6" type="revolute">
        <pose relative_to="link_5">0.07 0 0 0 0 0</pose>
        <parent>link_5</parent>
        <child>link_6</child>
        <axis>
          <xyz>-1 0 0</xyz>
        </axis>
      </joint>
      <link name="link_6">
        <pose relative_to='joint_a6'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.0138</mass>
          <pose>-0.001 0 0 0 0 0</pose>
          <inertia>
            <ixx>0.00000274</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00000153</iyy>
            <iyz>0</iyz>
            <izz>0.00000153</izz>
          </inertia>
        </inertial>
        <visual name='link_6_visual'>
          <pose>-0.07 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/visual/j6.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_6_collision'>
          <pose>-0.07 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id_4s/collision/j6.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6_tool0" type="fixed">
        <parent>link_6</parent>
        <child>tool0</child>
        <pose relative_to="link_6">0 0 0 ${radians(180.0)} ${radians(-90.0)} 0</pose>
      </joint>
      <link name='tool0'>
        <pose relative_to='joint_a6_tool0'>0 0 0 0 0 0</pose>
        <inertial>
          <!-- This mass can't be read out from the controller and therefore is
          just a low artificial value. -->
          <mass>0.1</mass>
        </inertial>
      </link>

      <frame name='flange' attached_to='tool0' intrinsic:create_attachment_entity='true'/>
      <xacro:insert_block name='model_options'/>

    </model>
  </xacro:macro>
</sdf>
