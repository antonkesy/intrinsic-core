<sdf version='1.9' xmlns:xacro='http://www.ros.org/wiki/xacro' xmlns:intrinsic='https://intrinsic.ai/'>
  <xacro:macro name='lr_mate_200id_base_sdf' params='name **model_options'>
    <model name='${name}'>
      <intrinsic:ik_solver>spherical_wrist</intrinsic:ik_solver>
      <intrinsic:control_frequency_hz>250</intrinsic:control_frequency_hz>
      <intrinsic:cartesian_limits>
        <intrinsic:min_translational_position>-5 -5 -5</intrinsic:min_translational_position>
        <intrinsic:max_translational_position>5 5 5</intrinsic:max_translational_position>
        <!-- Read from the robot system variable $STMO_GRP[1].$MAX_SPD. If we would go faster,
        FANUC decreases the ACC/JERK limit further on the fly.-->
        <intrinsic:min_translational_velocity>-4 -4 -4</intrinsic:min_translational_velocity>
        <intrinsic:max_translational_velocity>4 4 4</intrinsic:max_translational_velocity>
        <intrinsic:min_translational_jerk>-150 -150 -150</intrinsic:min_translational_jerk>
        <intrinsic:max_translational_jerk>150 150 150</intrinsic:max_translational_jerk>
        <intrinsic:max_rotational_jerk>100</intrinsic:max_rotational_jerk>
      </intrinsic:cartesian_limits>

      <!-- Please note that all inertias are approximated assuming uniform
      density of linkages and dividing the total mass (25kg) of the robot-->
      <link name="base_link">
        <inertial>
          <mass>5.3</mass>
          <pose>-0.0146 -0.000342 0.0796 0 0 0</pose>
          <inertia>
            <ixx>0.025</ixx>
            <ixy>-0.000574</ixy>
            <ixz>0.000296</ixz>
            <iyy>0.0305</iyy>
            <iyz>-0.000122</iyz>
            <izz>0.0322</izz>
          </inertia>
        </inertial>
        <visual name='base_link_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/visual/base.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='base_link_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/collision/base.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a1" type="revolute">
        <pose relative_to="base_link">0 0 0 0 0 0</pose>
        <parent>base_link</parent>
        <child>link_1</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
      </joint>
      <link name="link_1">
        <pose relative_to='joint_a1'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>5.62</mass>
          <pose>0.0287 0.000102 0.2753 0 0 0</pose>
          <inertia>
            <ixx>0.0417</ixx>
            <ixy>0.0000238</ixy>
            <ixz>-0.00552</ixz>
            <iyy>0.0303</iyy>
            <iyz>0.000122</iyz>
            <izz>0.0322</izz>
          </inertia>
        </inertial>
        <visual name='link_1_visual'>
          <pose>0 0 0.33 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/visual/j1.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_1_collision'>
          <pose>0 0 0.33 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/collision/j1.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a2" type="revolute">
        <pose relative_to="link_1">0.050 0 0.330 0 0 ${radians(90)}</pose>
        <parent>link_1</parent>
        <child>link_2</child>
        <axis>
          <xyz>1 0 0</xyz>
        </axis>
      </joint>
      <link name="link_2">
        <pose relative_to='joint_a2'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>9.05</mass>
          <pose>-0.000976 0.00271 0.159 0 0 0</pose>
          <inertia>
            <ixx>0.136</ixx>
            <ixy>-0.0000335</ixy>
            <ixz>-0.00108</ixz>
            <iyy>0.159</iyy>
            <iyz>-0.000154</iyz>
            <izz>0.0429</izz>
          </inertia>
        </inertial>
        <visual name='link_2_visual'>
          <pose>0 0 0 0 0 ${radians(-90.0)}</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/visual/j2.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_2_collision'>
          <pose>0 0 0 0 0 ${radians(-90.0)}</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/collision/j2.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a3" type="revolute">
        <pose relative_to="link_2">0 0 0.33 0 0 ${radians(-90)}</pose>
        <parent>link_2</parent>
        <child>link_3</child>
        <axis>
          <xyz>0 -1 0</xyz>
        </axis>
      </joint>
      <link name="link_3">
        <pose relative_to='joint_a3'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>2.15</mass>
          <pose>0.00887 -0.0000626 0.0171 0 0 0</pose>
          <inertia>
            <ixx>0.00585</ixx>
            <ixy>-0.000046</ixy>
            <ixz>-0.000622</ixz>
            <iyy>0.00665</iyy>
            <iyz>-0.0000461</iyz>
            <izz>0.00669</izz>
          </inertia>
        </inertial>
        <visual name='link_3_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/visual/j3.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_3_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/collision/j3.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a4" type="revolute">
        <pose relative_to="link_3">0 0 0.035 0 0 0</pose>
        <parent>link_3</parent>
        <child>link_4</child>
        <axis>
          <xyz>-1 0 0</xyz>
        </axis>
      </joint>
      <link name="link_4">
        <pose relative_to='joint_a4'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>2.42</mass>
          <pose>0.223 0.00356 0.00215 0 0 0</pose>
          <inertia>
            <ixx>0.00395</ixx>
            <ixy>0.000000261</ixy>
            <ixz>0.0000725</ixz>
            <iyy>0.0171</iyy>
            <iyz>-0.00000947</iyz>
            <izz>0.0171</izz>
          </inertia>
        </inertial>
        <visual name='link_4_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/visual/j4.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_4_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/collision/j4.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a5" type="revolute">
        <pose relative_to="link_4">0.335 0 0 0 0 0 </pose>
        <parent>link_4</parent>
        <child>link_5</child>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
      </joint>
      <link name="link_5">
        <pose relative_to='joint_a5'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.446</mass>
          <pose>0.0177 0.0025 -0.00000419 0 0 0</pose>
          <inertia>
            <ixx>0.000339</ixx>
            <ixy>0.0000187</ixy>
            <ixz>-0.0000000209</ixz>
            <iyy>0.000601</iyy>
            <iyz>-0.0000000171</iyz>
            <izz>0.000563</izz>
          </inertia>
        </inertial>
        <visual name='link_5_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/visual/j5.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_5_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/collision/j5.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6" type="revolute">
        <pose relative_to="link_5">0.08 0 0 0 ${radians(-90)} ${radians(180)}</pose>
        <parent>link_5</parent>
        <child>link_6</child>
        <axis>
          <xyz>0 0 -1</xyz>
        </axis>
      </joint>
      <link name="link_6">
        <pose relative_to='joint_a6'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.0134</mass>
          <pose>0 0 -0.006 0 0 0</pose>
          <inertia>
            <ixx>0.00000153</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00000153</iyy>
            <iyz>0</iyz>
            <izz>0.00000275</izz>
          </inertia>
        </inertial>
        <visual name='link_6_visual'>
          <pose>0 0 -0.08 ${radians(180.0)} ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/visual/j6.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_6_collision'>
          <pose>0 0 -0.08 ${radians(180.0)} ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/lr_mate_200id/collision/j6.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6_tool0" type="fixed">
        <parent>link_6</parent>
        <child>tool0</child>
        <pose relative_to="link_6">0 0 0 0 0 0</pose>
      </joint>
      <link name='tool0'>
        <pose relative_to='joint_a6_tool0'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
        </inertial>
      </link>

      <frame name='flange' attached_to='tool0' intrinsic:create_attachment_entity='true'/>
      <xacro:insert_block name='model_options'/>

    </model>
  </xacro:macro>
</sdf>
