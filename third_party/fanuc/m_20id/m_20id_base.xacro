<sdf version='1.9' xmlns:xacro='http://www.ros.org/wiki/xacro' xmlns:intrinsic='https://intrinsic.ai/'>
  <xacro:macro name='m_20id_base_sdf' params='name **model_options'>
    <model name='${name}'>
      <intrinsic:control_frequency_hz>250</intrinsic:control_frequency_hz>
      <intrinsic:ik_solver>spherical_wrist</intrinsic:ik_solver>
      <!-- Cartesian Acceleration limits are omitted to avoid excessive slowdown
      of robot motions by default. Cartesian Jerk limits are only used during
      jogging. Furthermore adhereing to the Cartesian velocity limits is
      necessary to follow the correct joint limits set. -->
      <intrinsic:cartesian_limits>
        <intrinsic:min_translational_position>-5 -5 -5</intrinsic:min_translational_position>
        <intrinsic:max_translational_position>5 5 5</intrinsic:max_translational_position>
        <intrinsic:min_translational_velocity>-2 -2 -2</intrinsic:min_translational_velocity>
        <intrinsic:max_translational_velocity>2 2 2</intrinsic:max_translational_velocity>
        <intrinsic:min_translational_jerk>-100 -100 -100</intrinsic:min_translational_jerk>
        <intrinsic:max_translational_jerk>100 100 100</intrinsic:max_translational_jerk>
        <intrinsic:max_rotational_jerk>100</intrinsic:max_rotational_jerk>
      </intrinsic:cartesian_limits>

      <link name="base_link">
        <inertial>
          <mass>45.8</mass>
          <pose>-0.0767 0.00288 0.109 0 0 0</pose>
          <inertia>
            <ixx>0.497</ixx>
            <ixy>0.029</ixy>
            <ixz>0.0137</ixz>
            <iyy>1.1</iyy>
            <iyz>0.0000537</iyz>
            <izz>1.16</izz>
          </inertia>
        </inertial>
        <visual name='base_link_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/visual/base.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='base_link_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/collision/base.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a1" type="revolute">
        <pose relative_to="base_link">0 0 0.157 0 0 ${radians(180.0)}</pose>
        <parent>base_link</parent>
        <child>link_1</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
      </joint>
      <link name="link_1">
        <pose relative_to='joint_a1'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>62.8</mass>
          <pose>-0.0158 0.0106 0.1849 0 0 0</pose>
          <inertia>
            <ixx>1.35</ixx>
            <ixy>0.133</ixy>
            <ixz>0.0417</ixz>
            <iyy>1.11</iyy>
            <iyz>0.108</iyz>
            <izz>1.3</izz>
          </inertia>
        </inertial>
        <visual name='link_1_visual'>
          <pose>0 0 0.268 0 0 ${radians(180.0)}</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/visual/j1.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_1_collision'>
          <pose>0 0 0.268 0 0 ${radians(180.0)}</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/collision/j1.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a2" type="revolute">
          <pose relative_to="link_1">-0.075 0 0.268 0 0 ${radians(180.0)} </pose>
        <parent>link_1</parent>
        <child>link_2</child>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
      </joint>
      <link name="link_2">
        <pose relative_to='joint_a2'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>65.8</mass>
          <pose>-0.0343 -0.172 0.38 0 0 0</pose>
          <inertia>
            <ixx>4.86</ixx>
            <ixy>-0.0809</ixy>
            <ixz>0.0453</ixz>
            <iyy>4.98</iyy>
            <iyz>-0.118</iyz>
            <izz>0.536</izz>
          </inertia>
        </inertial>
        <visual name='link_2_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/visual/j2.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_2_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/collision/j2.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a3" type="revolute">
        <pose relative_to="link_2">0 0 0.84 0 0 0</pose>
        <parent>link_2</parent>
        <child>link_3</child>
        <axis>
          <xyz>0 -1 0</xyz>
        </axis>
      </joint>
      <link name="link_3">
        <pose relative_to='joint_a3'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>52.9</mass>
          <pose>0.134 0.00796 0.103 0 0 0</pose>
          <inertia>
            <ixx>0.901</ixx>
            <ixy>-0.0784</ixy>
            <ixz>-0.294</ixz>
            <iyy>1.13</iyy>
            <iyz>-0.0385</iyz>
            <izz>1.06</izz>
          </inertia>
        </inertial>
        <visual name='link_3_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/visual/j3.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_3_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/collision/j3.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a4" type="revolute">
        <pose relative_to="link_3">0.3012 0 0.215 0 0 0</pose>
        <parent>link_3</parent>
        <child>link_4</child>
        <axis>
          <xyz>-1 0 0</xyz>
        </axis>
      </joint>
      <link name="link_4">
        <pose relative_to='joint_a4'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>20.2</mass>
          <pose>0.2848 -0.0481 -0.000358 0 0 0</pose>
          <inertia>
            <ixx>0.0769</ixx>
            <ixy>0.053</ixy>
            <ixz>-0.00106</ixz>
            <iyy>0.647</iyy>
            <iyz>-0.0000313</iyz>
            <izz>0.656</izz>
          </inertia>
        </inertial>
        <visual name='link_4_visual'>
          <pose>-0.3012 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/visual/j4.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_4_collision'>
          <pose>-0.3012 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/collision/j4.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a5" type="revolute">
        <pose relative_to="link_4">0.5888 0 0 0 0 0</pose>
        <parent>link_4</parent>
        <child>link_5</child>
        <axis>
          <xyz>0 -1 0</xyz>
        </axis>
      </joint>
      <link name="link_5">
        <pose relative_to='joint_a5'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>1.98</mass>
          <pose>0.0276 -0.0121 0.000000522 0 0 0</pose>
          <inertia>
            <ixx>0.00394</ixx>
            <ixy>-0.000785</ixy>
            <ixz>0.0000000339</ixz>
            <iyy>0.00462</iyy>
            <iyz>0.00000000332</iyz>
            <izz>0.0041</izz>
          </inertia>
        </inertial>
        <visual name='link_5_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/visual/j5.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_5_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/collision/j5.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6" type="revolute">
        <pose relative_to="link_5">0.09 0 0 0  ${radians(-90.0)} ${radians(180)}</pose>
        <parent>link_5</parent>
        <child>link_6</child>
        <axis>
          <xyz>0 0 -1</xyz>
        </axis>
      </joint>
      <link name="link_6">
        <pose relative_to='joint_a6'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.558</mass>
          <pose>0.000000147 0.000000509 -0.0319 0 0 0</pose>
          <inertia>
            <ixx>0.000433</ixx>
            <ixy>-0.0000000227</ixy>
            <ixz>0.0000000019</ixz>
            <iyy>0.000433</iyy>
            <iyz>0.00000000703</iyz>
            <izz>0.000585</izz>
          </inertia>
        </inertial>
        <visual name='link_6_visual'>
          <pose>0 0 -0.09 ${radians(180.0)} ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/visual/j6.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='link_6_collision'>
          <pose>0 0 -0.09 ${radians(180.0)} ${radians(-90.0)} 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://third_party/fanuc/m_20id/collision/j6.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="joint_a6_tool0" type="fixed">
        <parent>link_6</parent>
        <child>tool0</child>
        <pose relative_to="link_6">0 0 0 0 0 0</pose>
      </joint>
      <link name='tool0'>
        <pose relative_to='joint_a6_tool0'>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00001</iyy>
            <iyz>0</iyz>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
      </link>

      <frame name='flange' attached_to='tool0' intrinsic:create_attachment_entity='true'/>
      <xacro:insert_block name='model_options'/>

    </model>
  </xacro:macro>
</sdf>
