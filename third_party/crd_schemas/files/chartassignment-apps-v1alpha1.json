{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Schema for ChartAssignment v1alpha1",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "clusterName": {
          "type": "string"
        },
        "namespaceName": {
          "type": "string"
        },
        "chart": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "inline": {
              "type": "string"
            },
            "values": {
              "type": "object"
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "observedGeneration": {
          "type": "integer"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lastUpdateTime": {
                "type": "string",
                "format": "date-time"
              },
              "lastTransitionTime": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "phase": {
          "type": "string"
        }
      }
    }
  },
  "required": []
}